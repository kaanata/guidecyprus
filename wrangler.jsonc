{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "guidecyprus",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"EMDASH_SITE_URL": "https://guidecyprus.divine-queen-9624.workers.dev",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "guidecyprus",
			"database_id": "dafb673c-b0c4-44bb-b542-63d744330ebb",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "guidecyprus-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
