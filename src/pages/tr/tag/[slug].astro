---
import { decodeSlug, getTerm } from "emdash";
import TagView from "../../../components/views/TagView.astro";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("tag", slug, {
	includeCounts: false,
	locale: Astro.currentLocale,
}) : null;

if (!term) {
	return Astro.rewrite("/404");
}
---

<TagView term={term} />
