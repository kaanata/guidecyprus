---
import AdSpace from "../components/AdSpace.astro";
import Base from "../layouts/Base.astro";
import { localePath } from "../utils/i18n";
import { t } from "../utils/strings";

const locale = Astro.currentLocale;
---

<Base title={t(locale, "notFound.title")}>
	<AdSpace space="top-banner" page="page" />
	<div class="not-found">
		<p class="not-found-code">{t(locale, "notFound.code")}</p>
		<h1>{t(locale, "notFound.title")}</h1>
		<p class="not-found-message">{t(locale, "notFound.message")}</p>

		<form class="not-found-search" action={localePath(locale, "/search")} method="get" role="search">
			<label for="not-found-q">{t(locale, "notFound.searchLabel")}</label>
			<div class="not-found-row">
				<input
					id="not-found-q"
					type="search"
					name="q"
					placeholder={t(locale, "notFound.searchPlaceholder")}
					autocomplete="off"
					enterkeyhint="search"
				/>
				<button type="submit">{t(locale, "search.button")}</button>
			</div>
		</form>

		<p class="not-found-home">
			<a href={localePath(locale, "/")}>{t(locale, "notFound.home")}</a>
		</p>
	</div>
</Base>

<style>
	/* Same container and left edge as every other page; the content itself
	 * stays a narrow column. */
	.not-found {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6) 0;
	}

	.not-found > * {
		max-width: 36rem;
	}

	.not-found-code {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-muted);
		margin-bottom: var(--spacing-3);
	}

	.not-found h1 {
		font-size: var(--font-size-4xl);
		margin-bottom: var(--spacing-4);
	}

	.not-found-message {
		color: var(--color-text-secondary);
		max-width: 60ch;
		margin-bottom: var(--spacing-10);
	}

	.not-found-search label {
		display: block;
		font-size: var(--font-size-sm);
		font-weight: 600;
		margin-bottom: var(--spacing-2);
	}

	.not-found-row {
		display: flex;
		gap: var(--spacing-2);
	}

	.not-found-row input {
		flex: 1;
		min-width: 0;
		height: 3.5rem;
		padding: 0 var(--spacing-4);
		font: inherit;
		font-size: var(--font-size-base);
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-text-secondary);
		border-radius: var(--radius);
	}

	.not-found-row input::placeholder {
		color: var(--color-muted);
		opacity: 1;
	}

	/* The global :focus-visible ring (English Red) marks focus; the
	 * border firms up to ink. */
	.not-found-row input:focus-visible {
		border-color: var(--color-text);
	}

	.not-found-row button {
		flex: none;
		height: 3.5rem;
		padding: 0 var(--spacing-6);
		font: inherit;
		font-size: var(--font-size-base);
		font-weight: 600;
		color: var(--color-on-button);
		background: var(--color-button);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
		transition: background-color var(--transition-fast);
	}

	.not-found-row button:hover {
		color: var(--color-on-button-hover);
		background: var(--color-button-hover);
	}

	.not-found-home {
		margin-top: var(--spacing-8);
		font-size: var(--font-size-sm);
	}

	@media (max-width: 760px) {
		.not-found {
			padding: var(--spacing-12) var(--spacing-4) 0;
		}

		.not-found h1 {
			font-size: var(--font-size-3xl);
		}
	}
</style>
