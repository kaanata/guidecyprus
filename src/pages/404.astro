---
import AdSpace from "../components/AdSpace.astro";
import Base from "../layouts/Base.astro";
import { localePath } from "../utils/i18n";
import { t } from "../utils/strings";

const locale = Astro.currentLocale;
---

<Base title={t(locale, "notFound.title")}>
	<AdSpace space="top-banner" page="page" />
	<div class="not-found">
		<h1>404</h1>
		<p>{t(locale, "notFound.message")}</p>
		<a href={localePath(locale, "/")}>{t(locale, "notFound.home")}</a>
	</div>
</Base>

<style>
	.not-found {
		text-align: center;
		padding: var(--spacing-24) var(--spacing-6);
	}

	.not-found h1 {
		font-size: var(--font-size-5xl);
		margin-bottom: var(--spacing-2);
		color: var(--color-border);
	}

	.not-found p {
		color: var(--color-muted);
		margin-bottom: var(--spacing-6);
	}

	.not-found a {
		color: var(--color-text);
	}
</style>
