---
import { localePath } from "../utils/i18n";

interface Props {
  tags: Array<{ slug: string; label: string }>;
  class?: string;
}

const { tags, class: className } = Astro.props;
---

{tags.length > 0 && (
  <ul class:list={["tag-list", className]}>
    {tags.map((tag) => (
      <li>
        <a href={localePath(Astro.currentLocale, `/tag/${tag.slug}`)} class="tag">{tag.label}</a>
      </li>
    ))}
  </ul>
)}

<style>
  /* Tags are quiet inline links in small text: no pills, no separators. */
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--spacing-3);
    row-gap: var(--spacing-1);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: var(--leading-snug);
  }

  /* Links in the darkened Cerulian (the only text colour for links);
   * hover goes to ink, focus is the English Red ring. */
  .tag {
    color: var(--color-brand);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .tag:hover {
    color: var(--color-brand-hover);
  }

  .tag:focus-visible {
    outline: 2px solid var(--color-mark);
    outline-offset: 2px;
    border-radius: var(--radius);
  }
</style>
