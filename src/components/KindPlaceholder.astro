---
/**
 * The tile a place shows until it has a photo: the illustration for its kind
 * (src/utils/illustrations.ts), cropped to fill whatever box it sits in (the
 * containers fix the aspect ratio, so nothing shifts).
 *
 * The <img> carries `data-illustration`, so the logo-detection script in
 * Base.astro leaves it alone: these flat drawings would otherwise read as a
 * logo on a plain ground and be shrunk onto a tile.
 *
 * Decorative by default (alt=""): on cards the title and kind follow right
 * after. Pass `label` where the tile stands in for the photo itself (the
 * place page); it becomes the alt text and must say it is an illustration.
 */
import { kindIcon } from "../utils/kind";
import { KIND_ILLUSTRATION, kindIllustrationSrc } from "../utils/illustrations";

interface Props {
	/** The place's primary category slug (en or tr); unknown slugs get the generic place. */
	kind?: string;
	/** Alt text; omit when the tile is decorative. */
	label?: string;
	/** Load eagerly (above the fold). */
	priority?: boolean;
	class?: string;
}

const { kind, label, priority = false, class: className } = Astro.props;
---

<img
	class:list={["kind-ph", className]}
	src={kindIllustrationSrc(kindIcon(kind))}
	alt={label ?? ""}
	width={KIND_ILLUSTRATION.width}
	height={KIND_ILLUSTRATION.height}
	loading={priority ? "eager" : "lazy"}
	decoding={priority ? undefined : "async"}
	fetchpriority={priority ? "high" : undefined}
	data-illustration
/>

<style>
	/* Fills the caller's fixed-ratio box edge to edge; the box's sand
	 * background shows until the image arrives. */
	.kind-ph {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
</style>
