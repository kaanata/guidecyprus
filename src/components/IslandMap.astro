---
/**
 * The island, large: the one outline of Cyprus (src/utils/island.ts) in
 * limestone with a thin ink edge, and a single verdigris marker at Kyrenia.
 *
 * The marker and its label are HTML laid over the SVG (positioned in percent
 * of the viewBox), so they keep a fixed, legible size at any map width. The
 * marker's ring draws once on load; nothing else moves, and nothing at all
 * under prefers-reduced-motion.
 */
import { ISLAND_MARKERS, ISLAND_PATH, ISLAND_VIEWBOX } from "../utils/island";
import { t } from "../utils/strings";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const locale = Astro.currentLocale;

const [, , vbWidth, vbHeight] = ISLAND_VIEWBOX.split(" ").map(Number);
const kyrenia = ISLAND_MARKERS.kyrenia;
const left = `${((kyrenia.x / vbWidth) * 100).toFixed(2)}%`;
const top = `${((kyrenia.y / vbHeight) * 100).toFixed(2)}%`;
const label = t(locale, "home.mapKyrenia");
---

<figure class:list={["island-map", className]}>
	<div class="island-map__frame" style={`aspect-ratio: ${vbWidth} / ${vbHeight}`}>
		<svg
			class="island-map__svg"
			viewBox={ISLAND_VIEWBOX}
			role="img"
			aria-labelledby="island-map-title"
			preserveAspectRatio="xMidYMid meet"
		>
			<title id="island-map-title">{t(locale, "home.mapAlt")}</title>
			<path class="island-map__land" d={ISLAND_PATH} />
		</svg>
		<span class="island-map__marker" style={`left: ${left}; top: ${top}`} aria-hidden="true">
			<span class="island-map__dot"></span>
			<span class="island-map__label">{label}</span>
		</span>
	</div>
</figure>

<style>
	.island-map {
		margin: 0;
	}

	.island-map__frame {
		position: relative;
		width: 100%;
	}

	.island-map__svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.island-map__land {
		fill: var(--color-limestone);
		stroke: var(--color-text);
		stroke-width: 1.25px;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	.island-map__marker {
		position: absolute;
		/* The dot's centre sits on the coordinate. */
		width: 0;
		height: 0;
	}

	.island-map__dot {
		position: absolute;
		left: -7px;
		top: -7px;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--color-brand);
		box-sizing: border-box;
		border: 2.5px solid var(--color-bg);
		outline: 1.5px solid var(--color-brand);
	}

	/* One ring that opens out from the marker as the page arrives, then rests. */
	.island-map__dot::after {
		content: "";
		position: absolute;
		inset: -9px;
		border-radius: 50%;
		border: 1.5px solid var(--color-brand);
		opacity: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.island-map__dot::after {
			animation: island-marker-ring 1.6s cubic-bezier(0.2, 0.7, 0.3, 1) 0.4s 1 both;
		}
	}

	@keyframes island-marker-ring {
		0% {
			transform: scale(0.3);
			opacity: 0.9;
		}
		100% {
			transform: scale(2.2);
			opacity: 0;
		}
	}

	/* Kyrenia sits on the north coast; the label goes above it, over the sea. */
	.island-map__label {
		position: absolute;
		left: 0;
		bottom: 14px;
		transform: translateX(-50%);
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		font-weight: 600;
		line-height: 1;
		color: var(--color-text);
		white-space: nowrap;
	}
</style>
