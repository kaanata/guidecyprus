---
/**
 * The island, large, as a Wada plate: the one outline of Cyprus
 * (src/utils/island.ts) in Ivory Buff (--color-sand) on a flat field of
 * Cerulian Blue (--color-sea), with a single English Red marker
 * (--color-mark) at Kyrenia. Flat colour only: no edge on the land, no
 * gradient, no texture.
 *
 * The marker and its label are HTML laid over the SVG (positioned in percent
 * of the viewBox), so they keep a fixed, legible size at any map width. The
 * marker's ring draws once on load; nothing else moves, and nothing at all
 * under prefers-reduced-motion.
 */
import { ISLAND_MARKERS, ISLAND_PATH, ISLAND_VIEWBOX } from "../utils/island";
import { t } from "../utils/strings";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const locale = Astro.currentLocale;

const [, , vbWidth, vbHeight] = ISLAND_VIEWBOX.split(" ").map(Number);
const kyrenia = ISLAND_MARKERS.kyrenia;
const left = `${((kyrenia.x / vbWidth) * 100).toFixed(2)}%`;
const top = `${((kyrenia.y / vbHeight) * 100).toFixed(2)}%`;
const label = t(locale, "home.mapKyrenia");
---

<figure class:list={["island-map", className]}>
	<div class="island-map__frame" style={`aspect-ratio: ${vbWidth} / ${vbHeight}`}>
		<svg
			class="island-map__svg"
			viewBox={ISLAND_VIEWBOX}
			role="img"
			aria-labelledby="island-map-title"
			preserveAspectRatio="xMidYMid meet"
		>
			<title id="island-map-title">{t(locale, "home.mapAlt")}</title>
			<path class="island-map__land" d={ISLAND_PATH} />
		</svg>
		<span class="island-map__marker" style={`left: ${left}; top: ${top}`} aria-hidden="true">
			<span class="island-map__dot"></span>
			<span class="island-map__label">{label}</span>
		</span>
	</div>
</figure>

<style>
	/* The sea: a crisp flat rectangle, the island set inside it with room
	   all round, like a plate in the book. */
	.island-map {
		margin: 0;
		padding: 11% 8%;
		background: var(--color-sea);
	}

	.island-map__frame {
		position: relative;
		width: 100%;
	}

	.island-map__svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.island-map__land {
		fill: var(--color-sand);
		stroke: none;
	}

	.island-map__marker {
		position: absolute;
		/* The dot's centre sits on the coordinate. */
		width: 0;
		height: 0;
	}

	.island-map__dot {
		position: absolute;
		left: -7px;
		top: -7px;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--color-mark);
		/* A thin ink ring, with a hair of sand between, so the red reads on
		   the sand in both modes. --color-ink-band is Violet Blue (light) or
		   near-black navy (dark): dark on sand either way. */
		outline: 1.5px solid var(--color-ink-band);
		outline-offset: 1.5px;
	}

	/* One ring that opens out from the marker as the page arrives, then rests. */
	.island-map__dot::after {
		content: "";
		position: absolute;
		inset: -9px;
		border-radius: 50%;
		border: 1.5px solid var(--color-mark);
		opacity: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.island-map__dot::after {
			animation: island-marker-ring 1.6s cubic-bezier(0.2, 0.7, 0.3, 1) 0.4s 1 both;
		}
	}

	@keyframes island-marker-ring {
		0% {
			transform: scale(0.3);
			opacity: 0.9;
		}
		100% {
			transform: scale(2.2);
			opacity: 0;
		}
	}

	/* Kyrenia sits on the north coast. Ink on Cerulian fails contrast, so the
	   label goes below the marker, on the land: ink on sand is 6.3:1 in light,
	   and the dark band colour on the dark-mode sand is higher still. */
	.island-map__label {
		position: absolute;
		left: 0;
		top: 15px;
		transform: translateX(-50%);
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		font-weight: 600;
		line-height: 1;
		color: var(--color-ink-band);
		white-space: nowrap;
	}
</style>
