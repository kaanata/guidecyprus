---
import { getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import AdSpace from "../AdSpace.astro";
import type { ResolvedEntry } from "../../utils/resolve-entry";
import { resolveBlogSiteIdentity, TITLE_SEPARATOR } from "../../utils/site-identity";

interface Props {
	page: Extract<ResolvedEntry, { collection: "pages" }>["entry"];
	/** Ad targeting: the locale front page is "home", any other page is "page". */
	adPage?: "home" | "page";
}

const { page, adPage = "page" } = Astro.props;
const slug = page.data.slug;
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const isHome = adPage === "home";
const seo = getSeoMeta(page, {
	// The locale front page uses its SEO title alone, as WordPress did.
	siteTitle: isHome ? undefined : siteTitle,
	siteUrl: Astro.url.origin,
	// Keep "/" for the root so the home page gets a canonical too.
	path: Astro.url.pathname.replace(/(.)\/$/, "$1"),
	titleSeparator: TITLE_SEPARATOR,
});

// The front pages link to each other's locale homes, not to their page slugs
// (which only 301 home). EmDash adds hreflang for content pages, so the home
// pages render without a content reference and supply their own.
const origin = Astro.url.origin;
const homeAlternates = isHome
	? [
			{ hreflang: "en", href: `${origin}/` },
			{ hreflang: "tr", href: `${origin}/tr` },
			{ hreflang: "x-default", href: `${origin}/` },
		]
	: undefined;
---

<Base
	title={seo.title}
	standaloneTitle={isHome}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	content={isHome ? undefined : { collection: "pages", id: page.data.id, slug }}
	alternates={homeAlternates}
>
	<AdSpace space="top-banner" page={adPage} />
	<article class="page-article">
		<header class="page-header">
			<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
		</header>

		<div class="page-content">
			<PortableText value={page.data.content} />
		</div>
	</article>
</Base>

<style>
	.page-article {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) 0;
	}

	@media (max-width: 760px) {
		.page-article {
			padding: var(--spacing-8) var(--spacing-4) 0;
		}
	}

	.page-header,
	.page-content {
		max-width: 68ch;
		margin-inline: auto;
	}

	/* On wide screens the reading column sits exactly where a place page's body
	 * column does (same three-track grid as PostView), so the two read alike. */
	@media (min-width: 1101px) {
		.page-article {
			display: grid;
			grid-template-columns:
				var(--meta-col-width) minmax(0, var(--content-width))
				var(--gutter-width);
			column-gap: var(--spacing-10);
			justify-content: center;
		}

		.page-header,
		.page-content {
			grid-column: 2;
			width: 100%;
			max-width: none;
		}
	}

	.page-header {
		margin-bottom: var(--spacing-10);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border);
	}

	.page-title {
		font-family: var(--font-display);
		font-weight: var(--font-weight-display);
		font-size: clamp(var(--font-size-3xl), 2rem + 2.4vw, var(--font-size-5xl));
		line-height: 1.05;
		letter-spacing: var(--tracking-tight);
		text-wrap: balance;
	}

	.page-content {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
	}

	.page-content :global(p) {
		margin-bottom: 1.25em;
	}

	.page-content :global(a) {
		color: var(--color-brand);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	.page-content :global(a:hover) {
		color: var(--color-brand-hover);
	}

	.page-content :global(h2) {
		font-family: var(--font-display);
		font-weight: var(--font-weight-display);
		font-size: var(--font-size-2xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-top: 1.75em;
		margin-bottom: 0.6em;
	}

	.page-content :global(h3) {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.page-content > :global(:first-child) {
		margin-top: 0;
	}

	.page-content :global(img) {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		border-radius: var(--radius);
	}

	.page-content :global(figure) {
		margin: 2em 0;
	}

	.page-content :global(figcaption) {
		margin-top: var(--spacing-2);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.page-content :global(blockquote) {
		margin: 1.5em 0;
		padding-left: var(--spacing-6);
		border-left: 2px solid var(--color-brand);
		color: var(--color-text-secondary);
	}

	.page-content :global(pre) {
		margin: 1.5em 0;
		padding: var(--spacing-4);
		background: var(--color-surface);
		border-radius: var(--radius);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
	}

	.page-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.15em 0.3em;
		border-radius: var(--radius);
	}

	.page-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.25em;
		padding-left: var(--spacing-5);
	}

	.page-content :global(li) {
		margin-bottom: 0.4em;
	}
</style>
