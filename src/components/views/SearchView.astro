---
import { getTermsForEntries, search } from "emdash";
import AdSpace from "../AdSpace.astro";
import Base from "../../layouts/Base.astro";
import ListingHeader from "./ListingHeader.astro";
import { inFeedAfter } from "../../utils/ads";
import { localePath } from "../../utils/i18n";
import { t, tn } from "../../utils/strings";
import { primaryKind } from "../../utils/kind";

const locale = Astro.currentLocale;
const query = Astro.url.searchParams.get("q")?.trim() || "";

// Use the FTS-backed search() API instead of loading every post and
// filtering in JS. FTS scales as the post count grows, returns ranked
// results, and handles tokenization/stemming. Templates that grep all
// post bodies in JS quickly become unusable past a few hundred posts.
// Results are scoped to the page's locale, like the header's live search.
const { items: results } = query
	? await search(query, { collections: ["posts"], locale, limit: 30 })
	: { items: [] };

// Each result's kind (its first category), in one batched query.
const kindsByEntry =
	results.length > 0
		? await getTermsForEntries(
				"posts",
				results.map((r) => r.id),
				"category",
				{ locale },
			)
		: new Map();
---

<Base
	title={query ? t(locale, "search.titleWithQuery", { query }) : t(locale, "listing.searchTitle")}
	description={t(locale, "listing.searchDescription")}
>
	<AdSpace space="top-banner" page="search" />
	<section class="search-page">
		<ListingHeader title={t(locale, "listing.searchTitle")} />

		<form method="get" action={localePath(locale, "/search")} class="search-form" role="search">
			<label for="search-q" class="search-label">{t(locale, "listing.searchLabel")}</label>
			<div class="search-row">
				<input
					id="search-q"
					type="search"
					name="q"
					value={query}
					placeholder={t(locale, "listing.searchPlaceholder")}
					class="search-input"
					autocomplete="off"
					enterkeyhint="search"
					autofocus={!query}
				/>
				<button type="submit" class="search-button">{t(locale, "search.button")}</button>
			</div>
		</form>

		{
			query ? (
				<p class="search-summary" role="status">
					{results.length === 0
						? t(locale, "listing.searchNone", { query })
						: tn(locale, "listing.searchCount", results.length, { query })}
				</p>
			) : (
				<p class="search-hint">{t(locale, "listing.searchHint")}</p>
			)
		}

		{
			query && results.length === 0 && (
				<ul class="search-next">
					<li>
						<a href={localePath(locale, "/posts")}>{t(locale, "listing.emptyAll")}</a>
					</li>
				</ul>
			)
		}

		{
			results.length > 0 && (
				<ol class="search-results">
					{results.map((result, index) => {
						// A snippet that only repeats the title adds nothing.
						const snippetText = result.snippet
							?.replace(/<\/?mark>/g, "")
							.replace(/&(amp|lt|gt|quot|#39);/g, (_, e: string) =>
								({ amp: "&", lt: "<", gt: ">", quot: '"', "#39": "'" })[e] ?? "",
							)
							.trim();
						const showSnippet = !!snippetText && snippetText !== result.title?.trim();
						const kind = primaryKind(kindsByEntry.get(result.id));
						return (
							<>
								<li class="search-result">
									<h2 class="result-title">
										<a href={localePath(result.locale, `/${result.slug ?? result.id}`)}>
											{result.title ?? t(locale, "search.untitled")}
										</a>
									</h2>
									{kind && <p class="result-kind">{kind.label}</p>}
									{showSnippet && (
										<p class="result-snippet" set:html={result.snippet} />
									)}
								</li>
								{inFeedAfter(index, results.length) && (
									<AdSpace space="in-feed" as="li" />
								)}
							</>
						);
					})}
				</ol>
			)
		}
	</section>
</Base>

<style>
	.search-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) 0;
	}

	.search-page > :global(*:not(.listing-header)) {
		max-width: 46rem;
	}

	.search-form {
		margin: calc(-1 * var(--spacing-4)) 0 var(--spacing-6);
	}

	.search-label {
		display: block;
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-2);
	}

	.search-row {
		display: flex;
		gap: var(--spacing-2);
	}

	.search-input {
		flex: 1;
		min-width: 0;
		height: 3.5rem;
		padding: 0 var(--spacing-4);
		font: inherit;
		font-size: var(--font-size-base);
		border: 1px solid var(--color-text-secondary);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
	}

	.search-input::placeholder {
		color: var(--color-muted);
		opacity: 1;
	}

	.search-input:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
		border-color: var(--color-brand);
	}

	.search-button {
		height: 3.5rem;
		padding: 0 var(--spacing-6);
		font: inherit;
		font-size: var(--font-size-base);
		font-weight: 600;
		background: var(--color-brand);
		color: var(--color-on-brand);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
	}

	.search-button:hover {
		background: var(--color-brand-hover);
	}

	.search-button:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}

	.search-summary,
	.search-hint {
		font-size: var(--font-size-base);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
		margin: 0 0 var(--spacing-8);
	}

	.search-summary {
		color: var(--color-text);
		font-weight: 600;
	}

	.search-next {
		list-style: none;
		padding: 0;
		margin: calc(-1 * var(--spacing-4)) 0 var(--spacing-8);
	}

	.search-next a {
		font-weight: 600;
		color: var(--color-brand);
		text-underline-offset: 0.2em;
	}

	.search-results {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--color-border);
	}

	.search-result {
		padding: var(--spacing-5) 0 var(--spacing-6);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	/* In-feed ad between results; margins vanish with the space when it is unfilled. */
	.search-results :global(.ad-slot) {
		margin-block: var(--spacing-6);
	}

	.result-title {
		font-family: var(--font-body);
		font-size: var(--font-size-lg);
		font-weight: 600;
		letter-spacing: normal;
		line-height: var(--leading-snug);
		margin: 0;
	}

	.result-title a {
		color: var(--color-text);
		text-decoration: none;
	}

	.result-title a:hover {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.result-kind {
		margin: var(--spacing-1) 0 0;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.result-snippet {
		margin: var(--spacing-2) 0 0;
		max-width: 68ch;
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	/* FTS returns <mark> wrapping the matched terms */
	.result-snippet :global(mark) {
		background: var(--color-brand-ring);
		color: var(--color-text);
		padding: 0 0.1em;
		border-radius: 2px;
	}

	@media (max-width: 760px) {
		.search-page {
			padding: var(--spacing-8) var(--spacing-4) 0;
		}

		.search-button {
			padding: 0 var(--spacing-4);
		}
	}
</style>
