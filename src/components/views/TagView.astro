---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import AdSpace from "../AdSpace.astro";
import ListingHeader from "./ListingHeader.astro";
import ListingEmpty from "./ListingEmpty.astro";
import PlaceGrid from "./PlaceGrid.astro";
import RegionSwitch from "../RegionSwitch.astro";
import { inFeedAfter } from "../../utils/ads";
import type { TaxonomyTerm } from "emdash";
import { localePath } from "../../utils/i18n";
import { t, tn } from "../../utils/strings";
import { REGION_IN, regionFromUrl, regionTermSlug, withRegion } from "../../utils/region";
import { primaryKind } from "../../utils/kind";

const locale = Astro.currentLocale;

interface Props {
	term: TaxonomyTerm;
}

const { term } = Astro.props;
// The "Visiting" choice (?region=trnc|south); null is the whole island.
const region = regionFromUrl(Astro.url);
const regionIn = region ? t(locale, REGION_IN[region]) : "";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	locale,
	// Taxonomy filters AND together: this tag, and the region when one is chosen.
	where: region
		? { tag: term.slug, region: regionTermSlug(locale, region) }
		: { tag: term.slug },
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Each card's kind (its first category), in one batched query rather than
// one getEntryTerms() round-trip per post.
const kindsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"category",
	{ locale },
);

const crumbs = [
	{ label: t(locale, "listing.home"), href: localePath(locale, "/") },
	{ label: t(locale, "listing.allPlaces"), href: withRegion(localePath(locale, "/posts"), region) },
];
---

<Base
	title={t(locale, "listing.tagTitle", { label: term.label })}
	description={term.description || t(locale, "listing.tagDescription", { label: term.label })}
>
	<AdSpace space="top-banner" page="tag" />
	<section class="listing">
		<ListingHeader
			title={term.label}
			lead={t(locale, "listing.tagLead")}
			count={
				posts.length === 0
					? undefined
					: region
						? tn(locale, "region.count", posts.length, { in: regionIn })
						: tn(locale, "listing.place", posts.length)
			}
			crumbs={crumbs}
			crumbLabel={t(locale, "listing.breadcrumb")}
		>
			{term.description && <p class="listing-intro">{term.description}</p>}
			<RegionSwitch class="listing-region" />
		</ListingHeader>

		{
			posts.length === 0 ? (
				region ? (
					<ListingEmpty
						message={t(locale, "region.emptyTag", { in: regionIn })}
						actions={[{ label: t(locale, "region.emptyWhole"), href: withRegion(Astro.url, null) }]}
					/>
				) : (
					<ListingEmpty message={t(locale, "listing.tagEmpty")} />
				)
			) : (
				<PlaceGrid>
					{posts.map((post, index) => (
						<>
							<PostCard
								title={post.data.title}
								excerpt={post.data.excerpt}
								featuredImage={post.data.featured_image}
								href={localePath(locale, `/${post.id}`)}
								kind={primaryKind(kindsByEntry.get(post.data.id))?.label}
								kindSlug={primaryKind(kindsByEntry.get(post.data.id))?.slug}
								priority={index < 3}
							/>
							{inFeedAfter(index, posts.length) && <AdSpace space="in-feed" />}
						</>
					))}
				</PlaceGrid>
			)
		}
	</section>
</Base>

<style>
	.listing {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) 0;
	}

	.listing :global(.listing-region) {
		margin-top: var(--spacing-4);
	}

	.listing-intro {
		max-width: 68ch;
		margin: var(--spacing-4) 0 0;
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	@media (max-width: 760px) {
		.listing {
			padding: var(--spacing-8) var(--spacing-4) 0;
		}
	}
</style>
