---
import { getEmDashCollection, getTaxonomyTermsWithCacheHint, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import AdSpace from "../AdSpace.astro";
import ListingHeader from "./ListingHeader.astro";
import ListingEmpty from "./ListingEmpty.astro";
import PlaceGrid from "./PlaceGrid.astro";
import { inFeedAfter } from "../../utils/ads";
import { localePath } from "../../utils/i18n";
import { t, tn } from "../../utils/strings";
import { primaryKind } from "../../utils/kind";

const locale = Astro.currentLocale;

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const [{ entries: posts, cacheHint }, { data: categories, cacheHint: termsHint }] =
	await Promise.all([
		getEmDashCollection("posts", {
			locale,
			orderBy: { published_at: "desc" },
		}),
		getTaxonomyTermsWithCacheHint("category", { locale }),
	]);

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(termsHint);
}

// Each card's kind (its first category), in one batched query rather than
// one getEntryTerms() round-trip per post.
const kindsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"category",
	{ locale },
);

// "Jump to kind": only kinds that have places, biggest first.
// Terms come back as a tree (Entertainment > Casino, Bar & Pub...); list every level.
const flatten = (terms: typeof categories): typeof categories =>
	terms.flatMap((term) => [term, ...flatten(term.children ?? [])]);
const kinds = [...new Map(flatten(categories).map((term) => [term.slug, term])).values()]
	.filter((term) => (term.count ?? 0) > 0 && term.slug !== "uncategorized")
	.sort((a, b) => (b.count ?? 0) - (a.count ?? 0) || a.label.localeCompare(b.label));
---

<Base title={t(locale, "listing.allPlaces")} description={t(locale, "listing.allDescription")}>
	<AdSpace space="top-banner" page="latest" />
	<section class="listing">
		<ListingHeader
			title={t(locale, "listing.allPlaces")}
			count={posts.length > 0 ? tn(locale, "listing.place", posts.length) : undefined}
		>
			{
				kinds.length > 0 && (
					<nav class="kinds" aria-labelledby="kinds-label">
						<h2 id="kinds-label" class="kinds-label">{t(locale, "listing.byKind")}</h2>
						<ul class="kinds-list">
							{kinds.map((term) => (
								<li>
									<a href={localePath(locale, `/category/${term.slug}`)} class="kind-link">
										<span class="kind-name">{term.label}</span>
										<span class="kind-count">{term.count}</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</ListingHeader>

		{
			posts.length === 0 ? (
				<ListingEmpty message={t(locale, "listing.empty")} showAll={false} />
			) : (
				<PlaceGrid>
					{posts.map((post, index) => (
						<>
							<PostCard
								title={post.data.title}
								excerpt={post.data.excerpt}
								featuredImage={post.data.featured_image}
								href={localePath(locale, `/${post.id}`)}
								kind={primaryKind(kindsByEntry.get(post.data.id))?.label}
								priority={index < 3}
							/>
							{inFeedAfter(index, posts.length) && <AdSpace space="in-feed" />}
						</>
					))}
				</PlaceGrid>
			)
		}
	</section>
</Base>

<style>
	.listing {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) 0;
	}

	.kinds {
		margin-top: var(--spacing-8);
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border-subtle);
	}

	.kinds-label {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		font-weight: 600;
		letter-spacing: normal;
		color: var(--color-text-secondary);
		margin: 0 0 var(--spacing-3);
	}

	.kinds-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.kind-link {
		display: inline-flex;
		align-items: baseline;
		gap: var(--spacing-2);
		padding: var(--spacing-2) var(--spacing-4);
		min-height: 44px;
		align-items: center;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text);
		text-decoration: none;
		font-weight: 600;
		font-size: var(--font-size-sm);
		transition:
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.kind-link:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.kind-count {
		font-weight: 400;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	@media (prefers-reduced-motion: reduce) {
		.kind-link {
			transition: none;
		}
	}

	@media (max-width: 760px) {
		.listing {
			padding: var(--spacing-8) var(--spacing-4) 0;
		}
	}
</style>
