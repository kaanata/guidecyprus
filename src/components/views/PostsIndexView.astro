---
import { getEmDashCollection, getTaxonomyTermsWithCacheHint, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import AdSpace from "../AdSpace.astro";
import ListingHeader from "./ListingHeader.astro";
import ListingEmpty from "./ListingEmpty.astro";
import PlaceGrid from "./PlaceGrid.astro";
import RegionSwitch from "../RegionSwitch.astro";
import { inFeedAfter } from "../../utils/ads";
import { localePath } from "../../utils/i18n";
import { t, tn } from "../../utils/strings";
import { countTerms, primaryKind } from "../../utils/kind";
import { REGION_IN, regionFromUrl, regionTermSlug, withRegion } from "../../utils/region";
import { townFromUrl, townLocative, townTermSlug, withTown } from "../../utils/towns";
import { TOWN_ILLUSTRATION, townIllustrationSrc } from "../../utils/illustrations";

const locale = Astro.currentLocale;
// The "Visiting" choice (?region=trnc|south); null is the whole island.
const region = regionFromUrl(Astro.url);
const regionIn = region ? t(locale, REGION_IN[region]) : "";

// The town (?town=<key>), from the map's markers or a place page. It only
// filters when the `town` taxonomy has the term (an older database has no
// towns, and an unknown key would otherwise match nothing).
const townChoice = townFromUrl(Astro.url);
const { data: townTerms, cacheHint: townsHint } = await getTaxonomyTermsWithCacheHint("town", {
	locale,
	includeCounts: false,
});
const townSlug = townChoice ? townTermSlug(locale, townChoice.key) : undefined;
const townTerm = townSlug ? townTerms.find((term) => term.slug === townSlug) : undefined;
const town = townChoice && townTerm ? { key: townChoice.key, slug: townTerm.slug, name: townTerm.label } : null;

// Taxonomy filters AND together: the region and the town, when chosen.
const where = {
	...(region ? { region: regionTermSlug(locale, region) } : {}),
	...(town ? { town: town.slug } : {}),
};

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const [{ entries: posts, cacheHint }, { data: categories, cacheHint: termsHint }] =
	await Promise.all([
		getEmDashCollection("posts", {
			locale,
			...(Object.keys(where).length > 0 ? { where } : {}),
			orderBy: { published_at: "desc" },
		}),
		getTaxonomyTermsWithCacheHint("category", { locale }),
	]);

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(termsHint);
	Astro.cache.set(townsHint);
}

// Each card's kind (its first category), in one batched query rather than
// one getEntryTerms() round-trip per post.
const kindsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"category",
	{ locale },
);

// "Jump to kind": only kinds that have places, biggest first.
// Terms come back as a tree (Entertainment > Casino, Bar & Pub...); list every level.
// The taxonomy's counts are whole-site; within a region or town, count the listed places.
const regionCounts = region || town ? countTerms(kindsByEntry) : null;
const flatten = (terms: typeof categories): typeof categories =>
	terms.flatMap((term) => [term, ...flatten(term.children ?? [])]);
const kinds = [...new Map(flatten(categories).map((term) => [term.slug, term])).values()]
	.map((term) => (regionCounts ? { ...term, count: regionCounts.get(term.slug) ?? 0 } : term))
	.filter((term) => (term.count ?? 0) > 0 && term.slug !== "uncategorized")
	.sort((a, b) => (b.count ?? 0) - (a.count ?? 0) || a.label.localeCompare(b.label));

const title = town
	? t(locale, "town.title", { town: townLocative(locale, town.name, "of") })
	: t(locale, "listing.allPlaces");
const clearTown = withTown(Astro.url, null);
// The chosen town's illustration, as a banner above the list (none if the town has no file).
// The alt already says it; the visible caption is hidden from screen readers so it isn't read twice.
const townBanner = town ? townIllustrationSrc(town.key) : undefined;
const townBannerLabel = town ? t(locale, "illustration.town", { town: town.name }) : "";
---

<Base title={title} description={t(locale, "listing.allDescription")}>
	<AdSpace space="top-banner" page="latest" />
	<section class="listing">
		<ListingHeader
			title={title}
			count={
				posts.length === 0
					? undefined
					: region
						? tn(locale, "region.count", posts.length, { in: regionIn })
						: tn(locale, "listing.place", posts.length)
			}
		>
			{town && (
				<p class="listing-town">
					<a href={clearTown}>{t(locale, "town.clear")}</a>
				</p>
			)}
			{townBanner && (
				<figure class="town-banner">
					<img
						src={townBanner}
						alt={townBannerLabel}
						width={TOWN_ILLUSTRATION.width}
						height={TOWN_ILLUSTRATION.height}
						loading="eager"
						fetchpriority="high"
						data-illustration
					/>
					<figcaption class="town-banner__caption" aria-hidden="true">{townBannerLabel}</figcaption>
				</figure>
			)}
			<RegionSwitch class="listing-region" />
			{
				kinds.length > 0 && (
					<nav class="kinds" aria-labelledby="kinds-label">
						<h2 id="kinds-label" class="kinds-label">{t(locale, "listing.byKind")}</h2>
						<ul class="kinds-list">
							{kinds.map((term) => (
								<li>
									<a href={withRegion(localePath(locale, `/category/${term.slug}`), region)} class="kind-link">
										<span class="kind-name">{term.label}</span>
										<span class="kind-count">{term.count}</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</ListingHeader>

		{
			posts.length === 0 ? (
				town ? (
					<ListingEmpty
						message={t(locale, "town.empty", { town: townLocative(locale, town.name) })}
						actions={[{ label: t(locale, "town.clear"), href: clearTown }]}
					/>
				) : region ? (
					<ListingEmpty
						message={t(locale, "region.empty", { in: regionIn })}
						actions={[{ label: t(locale, "region.emptyWhole"), href: withRegion(Astro.url, null) }]}
					/>
				) : (
					<ListingEmpty message={t(locale, "listing.empty")} showAll={false} />
				)
			) : (
				<PlaceGrid>
					{posts.map((post, index) => (
						<>
							<PostCard
								title={post.data.title}
								excerpt={post.data.excerpt}
								featuredImage={post.data.featured_image}
								href={localePath(locale, `/${post.id}`)}
								kind={primaryKind(kindsByEntry.get(post.data.id))?.label}
								kindSlug={primaryKind(kindsByEntry.get(post.data.id))?.slug}
								priority={index < 3}
							/>
							{inFeedAfter(index, posts.length) && <AdSpace space="in-feed" />}
						</>
					))}
				</PlaceGrid>
			)
		}
	</section>
</Base>

<style>
	.listing {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) 0;
	}

	.listing-town {
		margin: var(--spacing-2) 0 0;
	}

	.listing-town a {
		font-weight: 500;
	}

	/* The town's illustration: full width, 16:9 on phones, a shorter crop on
	 * wider screens so the list stays near the top. The box ratio is fixed,
	 * so nothing shifts as it loads. */
	.town-banner {
		margin: var(--spacing-6) 0 0;
	}

	.town-banner img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		object-position: center;
		border-radius: var(--radius);
		background: var(--color-sand);
	}

	@media (min-width: 761px) {
		.town-banner img {
			aspect-ratio: 21 / 9;
		}
	}

	/* Same 9px credit style as photo credits on the place page. */
	.town-banner__caption {
		margin-top: var(--spacing-2);
		font-size: 9px;
		line-height: 1.4;
		color: var(--color-muted);
	}

	.listing :global(.listing-region) {
		margin-top: var(--spacing-4);
	}

	.kinds {
		margin-top: var(--spacing-6);
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border-subtle);
	}

	.kinds-label {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		font-weight: 600;
		letter-spacing: normal;
		color: var(--color-text-secondary);
		margin: 0 0 var(--spacing-3);
	}

	/* Plain links in a wrapping row; the count sits beside each in muted
	 * text. No chips: tap height comes from the padding, not a box. */
	.kinds-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--spacing-6);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.kind-link {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		min-height: 44px;
		color: var(--color-brand);
		text-decoration: none;
		font-weight: 600;
		font-size: var(--font-size-base);
	}

	.kind-name {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.kind-link:hover {
		color: var(--color-brand-hover);
	}

	.kind-link:focus-visible {
		outline: 2px solid var(--color-mark);
		outline-offset: 2px;
		border-radius: var(--radius);
	}

	.kind-count {
		font-weight: 400;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 760px) {
		.listing {
			padding: var(--spacing-8) var(--spacing-4) 0;
		}
	}
</style>
