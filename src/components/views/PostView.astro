---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import {
	Image,
	PortableText,
	WidgetArea,
} from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import type { TaxonomyTerm } from "emdash";
import PostCard from "../../components/PostCard.astro";
import TagList from "../../components/TagList.astro";
import KindPlaceholder from "../../components/KindPlaceholder.astro";
import AdSpace from "../AdSpace.astro";
import { splitForInArticle } from "../../utils/ads";
import { resolveBlogSiteIdentity, TITLE_SEPARATOR } from "../../utils/site-identity";
import { localePath } from "../../utils/i18n";
import { formatDate, t } from "../../utils/strings";
import type { ResolvedEntry } from "../../utils/resolve-entry";
import { kindIcon, orderKinds } from "../../utils/kind";
import { regionFromTermSlug, withRegion, type RegionKey } from "../../utils/region";
import { townFromTermSlug, withTown } from "../../utils/towns";

const locale = Astro.currentLocale;

interface Props {
	post: Extract<ResolvedEntry, { collection: "posts" }>["entry"];
}

const { post } = Astro.props;

// Get featured image URL for OG fallback
// The image may have src (external) or meta.storageKey (local)
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	// Check for direct src
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	// Build from storageKey for local images
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(post.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

// Generate SEO meta from content
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: featuredImageUrl,
	titleSeparator: TITLE_SEPARATOR,
});

// A place's kind is its category. "Uncategorized" says nothing to a traveller,
// so it is left out.
function kindsOf(terms: TaxonomyTerm[] | undefined): TaxonomyTerm[] {
	return orderKinds(terms);
}

// Tags are hydrated onto the entry by getEmDashEntry; categories usually are
// too, with a single-entry lookup as the fallback.
const tags = post.data.terms?.tag ?? [];
const kinds = kindsOf(
	post.data.terms?.category ??
		(await getTermsForEntries("posts", [post.data.id], "category", { locale })).get(
			post.data.id,
		),
);
const primaryKind = kinds[0];

// The place's region (TRNC (KKTC) or South Cyprus), labelled by the taxonomy
// in this locale, and the practical note for visitors that goes with it.
const regionTerm = (
	post.data.terms?.region ??
	(await getTermsForEntries("posts", [post.data.id], "region", { locale })).get(post.data.id)
)?.[0];
const regionKey = regionFromTermSlug(regionTerm?.slug);
const REGION_NOTE: Record<RegionKey, "region.noteTrnc" | "region.noteSouth"> = {
	trnc: "region.noteTrnc",
	south: "region.noteSouth",
};

// The place's town, labelled by the `town` taxonomy in this locale. Absent on
// places without one (and on an older database with no towns).
const townTerm = (
	post.data.terms?.town ??
	(await getTermsForEntries("posts", [post.data.id], "town", { locale })).get(post.data.id)
)?.[0];
const town = townFromTermSlug(townTerm?.slug);

// "More places": others of the same kind first, topped up with the latest
// places when the kind has fewer than three others.
const MORE_COUNT = 3;
let otherPosts: Awaited<ReturnType<typeof getEmDashCollection<"posts">>>["entries"] = [];
if (primaryKind) {
	const { entries } = await getEmDashCollection("posts", {
		locale,
		where: { category: primaryKind.slug },
		orderBy: { published_at: "desc" },
		limit: MORE_COUNT + 1,
	});
	otherPosts = entries.filter((p) => p.id !== post.id).slice(0, MORE_COUNT);
}
const sameKind = primaryKind !== undefined && otherPosts.length === MORE_COUNT;
if (otherPosts.length < MORE_COUNT) {
	const { entries: recent } = await getEmDashCollection("posts", {
		locale,
		orderBy: { published_at: "desc" },
		limit: MORE_COUNT * 2 + 1,
	});
	const seen = new Set([post.id, ...otherPosts.map((p) => p.id)]);
	for (const p of recent) {
		if (otherPosts.length >= MORE_COUNT) break;
		if (!seen.has(p.id)) {
			otherPosts.push(p);
			seen.add(p.id);
		}
	}
}

// One batched query for the cards' kinds, rather than one per card.
const otherKindsByEntry = await getTermsForEntries(
	"posts",
	otherPosts.map((p) => p.data.id),
	"category",
	{ locale },
);
const morePlaces = otherPosts.map((p) => ({
	post: p,
	kind: kindsOf(otherKindsByEntry.get(p.data.id))[0],
}));

// In-article ad after the 2nd paragraph; short posts get none.
const inArticleSplit = splitForInArticle(post.data.content);

const addedDate = post.data.publishedAt ?? null;

// Small images (every logo, and the low-resolution imported photos) turn
// soft and oversized when stretched across the full-width photo row, so
// below this width the image is shown as a compact tile beside the title.
// Decided from the stored width, before render, so nothing shifts on load.
const COMPACT_IMAGE_BELOW = 900;
const imageWidth = post.data.featured_image?.width ?? 0;
const compactImage = imageWidth > 0 && imageWidth < COMPACT_IMAGE_BELOW;
// No photo at all: the kind's illustration takes the same compact spot, so
// the title doesn't sit beside an empty gutter. It stands in for the photo, so
// its alt names it ("Illustration of a hotel"), and a caption says it is an
// illustration, not a picture of this place.
const noImage = !post.data.featured_image;
const illustrationLabel = t(locale, `illustration.${kindIcon(primaryKind?.slug)}`);

// Freely licensed photos (e.g. Wikimedia Commons, CC BY-SA) carry their
// attribution in the image value's meta; the licence requires showing it.
type PhotoCredit = { author: string; license: string; licenseUrl?: string; sourceUrl?: string };
const photoCredit = (post.data.featured_image as { meta?: { credit?: PhotoCredit } } | undefined)?.meta?.credit;
const creditParts = photoCredit
	? t(locale, "place.photoCredit").split(/(\{author\}|\{license\}|\{source\})/)
	: [];
const categoryHref = (slug: string) => localePath(locale, `/category/${slug}`);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug: post.data.slug }}
>
	<AdSpace space="top-banner" page="article" />
	<article class="article">
		<div class:list={["article-grid", { "article-grid--badge": compactImage || noImage }]}>
			<header class="article-header">
				<nav class="breadcrumb" aria-label={t(locale, "place.breadcrumb")}>
					<ol>
						<li>
							{
								primaryKind ? (
									<a href={categoryHref(primaryKind.slug)}>{primaryKind.label}</a>
								) : (
									<a href={localePath(locale, "/posts")}>{t(locale, "place.places")}</a>
								)
							}
						</li>
						<li aria-current="page">{post.data.title}</li>
					</ol>
				</nav>
				<h1 class="article-title" {...post.edit.title}>{post.data.title}</h1>
				{
					post.data.excerpt && (
						<p class="article-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
					)
				}
			</header>

			{
				post.data.featured_image && (
					<figure class:list={["article-hero-figure", { "article-badge": compactImage }]}>
						<div
							class="article-hero"
							data-photo-frame
							data-fit={compactImage ? undefined : "contain"}
							{...post.edit.featured_image}
						>
							<Image image={post.data.featured_image} priority />
						</div>
						{photoCredit && (
							<figcaption class="photo-credit">
								{creditParts.map((part) =>
									part === "{author}" ? photoCredit.author
									: part === "{license}" ? (photoCredit.licenseUrl
										? <a href={photoCredit.licenseUrl} rel="license noopener" target="_blank">{photoCredit.license}</a>
										: photoCredit.license)
									: part === "{source}" ? (photoCredit.sourceUrl
										? <a href={photoCredit.sourceUrl} rel="noopener" target="_blank">Wikimedia Commons</a>
										: "Wikimedia Commons")
									: part,
								)}
							</figcaption>
						)}
					</figure>
				)
			}
			{
				noImage && (
					<figure class="article-hero-figure article-badge">
						<div class="article-hero" {...post.edit.featured_image}>
							<KindPlaceholder kind={primaryKind?.slug} label={illustrationLabel} priority />
						</div>
						{/* The alt already says "Illustration of ..."; don't read it twice. */}
						<figcaption class="photo-credit" aria-hidden="true">{t(locale, "illustration.caption")}</figcaption>
					</figure>
				)
			}

			{/* Left column: what a traveller needs to place this */}
			<aside class="article-meta-col">
				<div class="meta-facts">
					<dl class="meta-list">
						{
							kinds.length > 0 && (
								<div class="meta-block">
									<dt class="meta-label">{t(locale, "place.kind")}</dt>
									<dd class="meta-value">
										{kinds.map((kind, i) => (
											<>
												{i > 0 && ", "}
												<a href={categoryHref(kind.slug)}>{kind.label}</a>
											</>
										))}
									</dd>
								</div>
							)
						}
						{
							regionTerm && (
								<div class="meta-block">
									<dt class="meta-label">{t(locale, "region.label")}</dt>
									<dd class="meta-value">
										{regionKey ? (
											<a href={withRegion(localePath(locale, "/posts"), regionKey)}>{regionTerm.label}</a>
										) : (
											regionTerm.label
										)}
									</dd>
								</div>
							)
						}
						{
							townTerm && (
								<div class="meta-block">
									<dt class="meta-label">{t(locale, "town.label")}</dt>
									<dd class="meta-value">
										{town ? (
											<a href={withTown(localePath(locale, "/posts"), town.key)}>{townTerm.label}</a>
										) : (
											townTerm.label
										)}
									</dd>
								</div>
							)
						}
						{
							addedDate && (
								<div class="meta-block">
									<dt class="meta-label">{t(locale, "place.added")}</dt>
									<dd class="meta-value">
										<time datetime={addedDate.toISOString()}>{formatDate(locale, addedDate)}</time>
									</dd>
								</div>
							)
						}
						{
							tags.length > 0 && (
								<div class="meta-block meta-block--tags">
									<dt class="meta-label">{t(locale, "place.tags")}</dt>
									<dd class="meta-value">
										<TagList tags={tags.map((tag) => ({ slug: tag.slug, label: tag.label }))} />
									</dd>
								</div>
							)
						}
					</dl>
					{
						regionKey && (
							<p class="region-note">
								{t(locale, REGION_NOTE[regionKey])}
							</p>
						)
					}
				</div>
			</aside>

			<div class="article-main">
				<div class="article-content">
					{
						inArticleSplit ? (
							<>
								<PortableText value={inArticleSplit[0]} />
								<AdSpace space="in-article" />
								<PortableText value={inArticleSplit[1]} />
							</>
						) : (
							<PortableText value={post.data.content} />
						)
					}
				</div>

				<div class="article-comments">
					<Comments collection="posts" contentId={post.data.id} threaded />
					<CommentForm collection="posts" contentId={post.data.id} />
				</div>
			</div>

			{/* Right gutter: TOC + sidebar widgets */}
			<aside class="article-sidebar">
				{/* Not inside the sticky block: a 600px ad would push the TOC off short screens. */}
				<div class="sidebar-ad">
					<AdSpace space="article-sidebar" as="div" />
				</div>
				<div class="sidebar-sticky">
					<nav class="toc" aria-label={t(locale, "post.tocLabel")}>
						<h2 class="toc-title">{t(locale, "post.toc")}</h2>
						<div class="toc-content" id="toc-content">
							<!-- Populated by JS -->
						</div>
					</nav>
					<div class="sidebar-widgets">
						<WidgetArea name="sidebar" />
					</div>
				</div>
			</aside>
		</div>
	</article>

	{
		morePlaces.length > 0 && (
			<section class="more-posts" aria-labelledby="more-places-title">
				<div class="more-inner">
					<div class="more-head">
						<h2 class="more-title" id="more-places-title">
							{sameKind && primaryKind
								? t(locale, "place.moreKind", { label: primaryKind.label })
								: t(locale, "place.more")}
						</h2>
						{sameKind && primaryKind && (
							<a class="more-all" href={categoryHref(primaryKind.slug)}>
								{t(locale, "place.moreAll", { label: primaryKind.label })}
							</a>
						)}
					</div>
					<div class="more-grid">
						{morePlaces.map(({ post: p, kind }) => (
							<PostCard
								title={p.data.title}
								featuredImage={p.data.featured_image}
								href={localePath(locale, `/${p.id}`)}
								kind={kind?.label}
								kindSlug={kind?.slug}
								headingLevel={3}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<script>
		// Build table of contents from h2/h3 headings
		function buildToc() {
			const content = document.querySelector(".article-content");
			const tocContainer = document.getElementById("toc-content");
			if (!content || !tocContainer) return;

			const headings = content.querySelectorAll("h2, h3");
			if (headings.length === 0) {
				// Hide TOC if no headings
				const toc = document.querySelector(".toc") as HTMLElement | null;
				if (toc) toc.style.display = "none";
				return;
			}

			const list = document.createElement("ul");
			list.className = "toc-list";

			headings.forEach((heading, index) => {
				// Add ID if missing
				if (!heading.id) {
					heading.id = `heading-${index}`;
				}

				const li = document.createElement("li");
				li.className =
					heading.tagName === "H3" ? "toc-item toc-item--nested" : "toc-item";

				const link = document.createElement("a");
				link.href = `#${heading.id}`;
				link.className = "toc-link";
				link.textContent = heading.textContent;

				li.appendChild(link);
				list.appendChild(li);
			});

			tocContainer.appendChild(list);

			// Highlight current section on scroll
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						const id = entry.target.id;
						const link = tocContainer.querySelector(`a[href="#${id}"]`);
						if (link) {
							if (entry.isIntersecting) {
								tocContainer
									.querySelectorAll(".toc-link")
									.forEach((l) => l.classList.remove("active"));
								link.classList.add("active");
							}
						}
					});
				},
				{ rootMargin: "-80px 0px -80% 0px" }
			);

			headings.forEach((heading) => observer.observe(heading));
		}

		buildToc();

		// Mark contact labels: a <strong> that opens a paragraph (or a line
		// after a <br>) and ends with a colon, like "Address:" or "Telefon:".
		function markContactLines() {
			const content = document.querySelector(".article-content");
			if (!content) return;
			const startsLine = (node: Node) => {
				let prev = node.previousSibling;
				while (prev && prev.nodeType === Node.TEXT_NODE && !prev.textContent?.trim()) {
					prev = prev.previousSibling;
				}
				return !prev || (prev instanceof HTMLElement && prev.tagName === "BR");
			};
			content.querySelectorAll("p > strong, p > b").forEach((label) => {
				if (!/:\s*$/.test(label.textContent ?? "")) return;
				if ((label.textContent ?? "").trim().length > 24) return;
				if (!startsLine(label)) return;
				label.classList.add("contact-label");
				label.parentElement?.classList.add("contact-line");
			});
			// Imported contact blocks often double the line break before each
			// label; drop the second one so the lines sit together.
			const isBr = (n: Node | null) => n instanceof HTMLElement && n.tagName === "BR";
			content.querySelectorAll(".contact-label").forEach((label) => {
				// Keep the gap before the first label, which ends the prose.
				if (label.parentElement?.querySelector(".contact-label") === label) return;
				const prev = label.previousSibling;
				if (!isBr(prev)) return;
				const before = prev?.previousSibling ?? null;
				if (isBr(before)) prev?.remove();
			});
		}

		markContactLines();
	</script>
</Base>

<style>
	/* ---------------------------------------------------------------
	 * Place page. Desktop is a three-column reading view: the meta
	 * column (kind, date added, tags), the body, and a gutter for the
	 * TOC and widgets. The header sits over the body column; the photo
	 * spans all three.
	 * ------------------------------------------------------------- */
	.article {
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	.article-grid {
		display: grid;
		grid-template-columns:
			var(--meta-col-width) minmax(0, var(--content-width))
			var(--gutter-width);
		grid-template-areas:
			". header ."
			"hero hero hero"
			"meta main side";
		column-gap: var(--spacing-10);
		justify-content: center;
		padding: var(--spacing-12) var(--spacing-6) 0;
		margin-bottom: var(--spacing-16);
	}

	/* Header */
	.article-header {
		grid-area: header;
		min-width: 0;
		margin-bottom: var(--spacing-8);
	}

	.breadcrumb ol {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		list-style: none;
		margin: 0 0 var(--spacing-4);
		padding: 0;
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
		color: var(--color-muted);
	}

	.breadcrumb li {
		min-width: 0;
	}

	.breadcrumb li + li::before {
		content: "/";
		padding-inline: var(--spacing-2);
		color: var(--color-border);
	}

	.breadcrumb a {
		color: var(--color-brand);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 3px;
	}

	.breadcrumb a:hover {
		text-decoration-color: currentColor;
	}

	.breadcrumb [aria-current] {
		color: var(--color-text);
		overflow-wrap: anywhere;
	}

	.article-title {
		font-family: var(--font-display);
		font-weight: var(--font-weight-display);
		font-size: clamp(var(--font-size-3xl), 4.2vw, var(--font-size-5xl));
		line-height: 1.08;
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin: 0;
		text-wrap: balance;
		overflow-wrap: break-word;
	}

	.article-excerpt {
		margin: var(--spacing-4) 0 0;
		max-width: 60ch;
		font-size: var(--font-size-lg);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
	}

	/* Photo: across the body and both gutters. width/height stay on the
	 * img, and the box ratio is fixed, so nothing shifts as it loads. */
	.article-hero-figure {
		grid-area: hero;
		margin: 0 0 var(--spacing-12);
	}

	.article-hero {
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--color-surface);
	}

	/* Imported media has no stored dimensions, so the fixed box ratio is what
	 * keeps CLS at 0. Many places use a logo as their photo; contain keeps a
	 * logo whole, and a photo near 3:2 still fills the box. */
	.article-hero :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: contain;
	}

	/* Licence attribution for a freely licensed photo. Size is fixed at 9px
	 * by the site owner's rule for credits. */
	.photo-credit {
		margin-top: var(--spacing-2);
		font-size: 9px;
		line-height: 1.4;
		color: var(--color-muted);
	}

	.photo-credit a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 1px;
	}

	/* Compact tile for small images: in the gutter column beside the title
	 * instead of the full-width photo row. Logos (data-logo, set by the
	 * photo-fit script) stay whole on their own colour; small photos fill. */
	.article-grid--badge {
		grid-template-areas:
			". header badge"
			"meta main side";
	}

	.article-badge {
		grid-area: badge;
		align-self: start;
		margin: 0 0 var(--spacing-8);
	}

	/* 4:3, like the place cards, so the tile is about as tall as the title block. */
	.article-badge .article-hero {
		aspect-ratio: 4 / 3;
	}

	.article-badge .article-hero :global(img) {
		height: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.article-badge .article-hero[data-logo] :global(img) {
		object-fit: contain;
		padding: 12%;
		box-sizing: border-box;
	}

	/* Left column: kind, date added, tags */
	.article-meta-col {
		grid-area: meta;
		min-width: 0;
	}

	/* The facts and the region note stay in view together. */
	.meta-facts {
		position: sticky;
		top: calc(var(--nav-height) + var(--spacing-8));
	}

	.meta-list {
		margin: 0;
		padding-top: var(--spacing-1);
	}

	.meta-block {
		margin: 0 0 var(--spacing-6);
	}

	.meta-label {
		font-size: var(--font-size-xs);
		font-weight: 600;
		line-height: var(--leading-snug);
		color: var(--color-muted);
		margin-bottom: var(--spacing-1);
	}

	.meta-value {
		margin: 0;
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
		color: var(--color-text);
	}

	.meta-value a {
		color: var(--color-brand);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.meta-value a:hover {
		color: var(--color-brand-hover);
	}

