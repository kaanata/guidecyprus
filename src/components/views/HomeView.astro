---
/**
 * The locale home page (/ and /tr): what the site is, a way in by search or
 * by kind of place, the latest places, then the front page's own CMS text.
 *
 * SEO, canonical and hreflang are the ones the front page has always had:
 * its SEO title stands alone, and the alternates point at the locale homes
 * rather than at the page slugs (which only 301 home).
 */
import {
	getEmDashCollection,
	getSeoMeta,
	getTaxonomyTermsWithCacheHint,
	getTermsForEntries,
	type TaxonomyTerm,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import AdSpace from "../AdSpace.astro";
import KindPlaceholder from "../KindPlaceholder.astro";
import RegionSwitch from "../RegionSwitch.astro";
import ListingEmpty from "./ListingEmpty.astro";
import type { ResolvedEntry } from "../../utils/resolve-entry";
import { localePath } from "../../utils/i18n";
import { TITLE_SEPARATOR } from "../../utils/site-identity";
import { t, tn } from "../../utils/strings";
import { countTerms, kindIcon, primaryKind } from "../../utils/kind";
import { REGION_IN, REGION_LABEL, regionFromUrl, regionTermSlug, withRegion } from "../../utils/region";
import { TOWNS, townFromTermSlug, withTown } from "../../utils/towns";
import {
	KIND_ILLUSTRATION,
	TOWN_ILLUSTRATION,
	kindIllustrationSrc,
	townIllustrationSrc,
} from "../../utils/illustrations";
import { KIND_PARAM } from "../../utils/finder";

interface Props {
	page: Extract<ResolvedEntry, { collection: "pages" }>["entry"];
}

const { page } = Astro.props;
const locale = Astro.currentLocale;

// The front page uses its SEO title alone, as WordPress did.
const seo = getSeoMeta(page, {
	siteTitle: undefined,
	siteUrl: Astro.url.origin,
	// Keep "/" for the root so the home page gets a canonical too.
	path: Astro.url.pathname.replace(/(.)\/$/, "$1"),
	titleSeparator: TITLE_SEPARATOR,
});

const origin = Astro.url.origin;
const homeAlternates = [
	{ hreflang: "en", href: `${origin}/` },
	{ hreflang: "tr", href: `${origin}/tr` },
	{ hreflang: "x-default", href: `${origin}/` },
];

/** Places shown under "Recently added": a lead (when one has a big enough image) and the rest. */
const RECENT_COUNT = 6;

// The "Visiting" choice (?region=trnc|south); null is the whole island.
// With a region, every published place in it is fetched (a few hundred at
// most): the newest fill "Recently added" and all of them give the kind counts.
const region = regionFromUrl(Astro.url);

const [recent, categoryTerms, townTerms] = await Promise.all([
	getEmDashCollection("posts", {
		locale,
		orderBy: { published_at: "desc" },
		...(region
			? { where: { region: regionTermSlug(locale, region) } }
			: { limit: RECENT_COUNT }),
	}),
	getTaxonomyTermsWithCacheHint("category", { locale }),
	getTaxonomyTermsWithCacheHint("town", { locale }),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(recent.cacheHint);
	Astro.cache.set(categoryTerms.cacheHint);
	Astro.cache.set(townTerms.cacheHint);
}

// Kinds of place: every category with posts in this locale, biggest first.
// "Uncategorized" is an import leftover, not a kind a traveller looks for.
function flatten(terms: TaxonomyTerm[]): TaxonomyTerm[] {
	return terms.flatMap((term) => [term, ...flatten(term.children ?? [])]);
}
// The taxonomy's counts are whole-site; within a region they are counted from
// the region's places (one batched query, reused for the cards' kinds).
const kindByPlace = await getTermsForEntries(
	"posts",
	(region ? recent.entries : recent.entries.slice(0, RECENT_COUNT)).map((p) => p.data.id),
	"category",
	{ locale },
);
const regionCounts = region ? countTerms(kindByPlace) : null;
// Within a region the finder offers only the region's towns, with their
// counts there (Nicosia has places on both sides).
const townCounts = region
	? countTerms(
			await getTermsForEntries("posts", recent.entries.map((p) => p.data.id), "town", { locale }),
		)
	: null;
const kinds = [...new Map(flatten(categoryTerms.data).map((term) => [term.slug, term])).values()]
	.map((term) => (regionCounts ? { ...term, count: regionCounts.get(term.slug) ?? 0 } : term))
	.filter((term) => (term.count ?? 0) > 0 && term.slug !== "uncategorized")
	.sort((a, b) => (b.count ?? 0) - (a.count ?? 0) || a.label.localeCompare(b.label, locale));

// Towns with places, most first: the finder's second dropdown and the town
// links under it. Names come from the term labels; the URL uses the town key.
const towns = townTerms.data
	.map((term) => ({ term, town: townFromTermSlug(term.slug) }))
	.filter((x): x is { term: TaxonomyTerm; town: (typeof TOWNS)[number] } => x.town !== undefined)
	.map(({ term, town }) => ({
		key: town.key,
		name: term.label,
		count: townCounts ? (townCounts.get(term.slug) ?? 0) : (term.count ?? 0),
		poster: townIllustrationSrc(town.key),
	}))
	.filter((town) => town.count > 0)
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, locale));

// The poster beside the finder: the chosen town's illustration, swapped in
// as the dropdown changes. Until one is chosen, the town with most places
// (Kyrenia, the guide's home harbour, when no town has places yet).
const posterTown = towns.find((town) => town.poster) ?? {
	name: t(locale, "town.kyrenia"),
	poster: townIllustrationSrc("kyrenia"),
};
const posterLabel = (name: string) => t(locale, "illustration.town", { town: name });

// "I'm looking for {kind} in {town}": the sentence around the two dropdowns.
const finderParts = t(locale, "home.finder").split(/(\{kind\}|\{town\})/).filter(Boolean);
const anyTown = region ? t(locale, REGION_LABEL[region]) : t(locale, "home.finderAnyTown");

const places = recent.entries.slice(0, RECENT_COUNT);
// A place's kind is its first category that names a kind of place, not the
// town ("girne") or the import leftover.
function kindOf(id: string) {
	return primaryKind(kindByPlace.get(id));
}

// The large lead card goes to the newest place with an image big enough to
// fill it. Logos and small imported photos would be blown up, so when none of
// the recent places has one, all cards are the same size.
const LEAD_MIN_WIDTH = 900;
const leadIndex = places.findIndex((p) => (p.data.featured_image?.width ?? 0) >= LEAD_MIN_WIDTH);
const hasLead = leadIndex >= 0;
const orderedPlaces = hasLead
	? [places[leadIndex], ...places.filter((_, i) => i !== leadIndex)]
	: places;
const finderAction = localePath(locale, "/posts");
---

<Base
	title={seo.title}
	standaloneTitle
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	alternates={homeAlternates}
>
	<div class="home">
		<section class="hero" aria-labelledby="home-title">
			<div class="hero__text">
				<h1 id="home-title" class="hero__title">{t(locale, "home.title")}</h1>
				<p class="hero__intro">{t(locale, "home.intro")}</p>
				<form class="finder" action={finderAction} method="get">
					<p class="finder__sentence">
						{finderParts.map((part) =>
							part === "{kind}" ? (
								<span class="finder__field">
									<label class="sr-only" for="finder-kind">{t(locale, "home.finderKind")}</label>
									<select id="finder-kind" class="finder__select" name={KIND_PARAM}>
										<option value="">{t(locale, "home.finderAnyKind")}</option>
										{kinds.map((kind) => (
											<option value={kind.slug}>{kind.label}</option>
										))}
									</select>
								</span>
							) : part === "{town}" ? (
								<span class="finder__field">
									<label class="sr-only" for="finder-town">{t(locale, "town.label")}</label>
									<select
										id="finder-town"
										class="finder__select"
										name="town"
										data-finder-town
									>
										<option
											value=""
											data-poster={posterTown.poster}
											data-poster-label={posterLabel(posterTown.name)}
										>
											{anyTown}
										</option>
										{towns.map((town) => (
											<option
												value={town.key}
												data-poster={town.poster}
												data-poster-label={posterLabel(town.name)}
											>
												{town.name}
											</option>
										))}
									</select>
								</span>
							) : (
								<span>{part}</span>
							),
						)}
					</p>
					{region && <input type="hidden" name="region" value={region} />}
					<button type="submit" class="finder__button">{t(locale, "home.finderButton")}</button>
				</form>
				{towns.length > 1 && (
					<nav class="towns" aria-labelledby="home-towns">
						<h2 id="home-towns" class="towns__label">{t(locale, "home.townsLabel")}</h2>
						<ul class="towns__list">
							{towns.map((town) => (
								<li>
									<a href={withRegion(withTown(localePath(locale, "/posts"), town.key), region)}>
										{town.name}
										<span class="towns__count">{town.count}</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				)}
			</div>
			{posterTown.poster && (
				<figure class="hero__poster">
					<img
						src={posterTown.poster}
						alt={posterLabel(posterTown.name)}
						width={TOWN_ILLUSTRATION.width}
						height={TOWN_ILLUSTRATION.height}
						loading="eager"
						fetchpriority="high"
						data-illustration
						data-finder-poster
					/>
					<figcaption class="hero__poster-caption" aria-hidden="true">
						{t(locale, "illustration.caption")}
					</figcaption>
				</figure>
			)}
		</section>

		<AdSpace space="top-banner" page="home" />

		{
			(kinds.length > 0 || region) && (
				<section class="home-section kinds" aria-labelledby="home-kinds">
					<div class="section-head kinds__head">
						<h2 id="home-kinds" class="section-title">
							{t(locale, "home.browseTitle")}
						</h2>
						<RegionSwitch id="home-region" />
					</div>
					{kinds.length === 0 && region && (
						<ListingEmpty
							message={t(locale, "region.empty", { in: t(locale, REGION_IN[region]) })}
							actions={[{ label: t(locale, "region.emptyWhole"), href: withRegion(Astro.url, null) }]}
						/>
					)}
					{kinds.length > 0 && <ul class="kinds__grid">
						{kinds.map((kind) => (
							<li>
								<a
									class="kind"
									href={withRegion(localePath(locale, `/category/${kind.slug}`), region)}
								>
									<span class="kind__art">
										<img
											src={kindIllustrationSrc(kindIcon(kind.slug))}
											alt=""
											width={KIND_ILLUSTRATION.width}
											height={KIND_ILLUSTRATION.height}
											loading="lazy"
											decoding="async"
											data-illustration
										/>
									</span>
									<span class="kind__name">{kind.label}</span>
									<span class="kind__count">{tn(locale, "home.browseCount", kind.count ?? 0)}</span>
								</a>
							</li>
						))}
					</ul>}
				</section>
			)
		}

		{
			orderedPlaces.length > 0 && (
				<section class="home-section recent" aria-labelledby="home-recent">
					<div class="section-head">
						<h2 id="home-recent" class="section-title">
							{t(locale, "home.recentTitle")}
						</h2>
						<a class="section-more" href={withRegion(localePath(locale, "/posts"), region)}>
							{t(locale, "home.recentAll")}
						</a>
					</div>
					<ul class:list={["recent__grid", { "recent__grid--lead": hasLead }]}>
						{orderedPlaces.map((place, index) => {
							const kind = kindOf(place.data.id);
							return (
								<li class:list={["place", { "place--lead": hasLead && index === 0 }]}>
									<a class="place__link" href={localePath(locale, `/${place.id}`)}>
										<div class="place__photo" data-photo-frame>
											{place.data.featured_image ? (
												<Image
													image={place.data.featured_image}
													sizes={
														hasLead && index === 0
															? "(min-width: 900px) 760px, 100vw"
															: "(min-width: 900px) 380px, 50vw"
													}
												/>
											) : (
												<KindPlaceholder kind={kind?.slug} />
											)}
										</div>
										<div class="place__text">
											<h3 class="place__title">{place.data.title}</h3>
											{kind && <p class="place__kind">{kind.label}</p>}
										</div>
									</a>
								</li>
							);
						})}
					</ul>
				</section>
			)
		}

		<AdSpace space="in-feed" />

		<section class="home-section about" aria-labelledby="home-about">
			<div class="about__head">
				<p class="about__label">{t(locale, "home.aboutLabel")}</p>
				<h2 id="home-about" class="section-title about__title" {...page.edit.title}>
					{page.data.title}
				</h2>
			</div>
			<div class="about__body">
				<PortableText value={page.data.content} />
			</div>
		</section>
	</div>
</Base>

<script>
	// Swap the poster as the town dropdown changes: a short fade out, the new
	// drawing in once it has loaded. Without JS the first poster just stays.
	for (const select of document.querySelectorAll("[data-finder-town]")) {
		if (!(select instanceof HTMLSelectElement)) continue;
		const poster = select.closest(".hero")?.querySelector<HTMLImageElement>("[data-finder-poster]");
		if (!poster) continue;
		select.addEventListener("change", () => {
			const option = select.selectedOptions[0];
			const src = option?.dataset.poster;
			if (!src || poster.getAttribute("src") === src) return;
			const next = new Image();
			next.src = src;
			poster.toggleAttribute("data-swapping", true);
			next.decode().catch(() => {}).finally(() => {
				poster.src = src;
				poster.alt = option.dataset.posterLabel ?? "";
				poster.toggleAttribute("data-swapping", false);
			});
		});
	}
</script>

<style>
	.home {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-6);
	}

	@media (max-width: 760px) {
		.home {
			padding: 0 var(--spacing-4);
		}
	}

	/* ---------- Hero: the finder sentence beside a town poster ---------- */

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--spacing-10);
		padding: var(--spacing-10) 0 var(--spacing-12);
	}

	.hero__title {
		font-family: var(--font-display);
		font-weight: var(--font-weight-display);
		font-size: var(--font-size-2xl);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	.hero__intro {
		margin-top: var(--spacing-3);
		max-width: 44ch;
		font-size: var(--font-size-base);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	/* The sentence is the page's one large piece of type; the two dropdowns
	 * are set in it, in the same face, marked by an English Red rule. */
	.finder {
		margin-top: var(--spacing-8);
	}

	.finder__sentence {
		font-family: var(--font-display);
		font-weight: var(--font-weight-display);
		font-size: clamp(1.75rem, 1.1rem + 2.7vw, 3.25rem);
		line-height: 1.3;
		letter-spacing: var(--tracking-tight);
		text-wrap: balance;
	}

	.finder__field {
		position: relative;
		display: inline-block;
		max-width: 100%;
	}

	.finder__select {
		appearance: none;
		/* Size to the chosen option where supported; elsewhere the widest one. */
		field-sizing: content;
		max-width: 100%;
		margin: 0;
		padding: 0 1.1em 0.04em 0;
		font: inherit;
		letter-spacing: inherit;
		color: var(--color-text);
		background: transparent;
		border: 0;
		border-bottom: 3px solid var(--color-mark);
		border-radius: 0;
		cursor: pointer;
		text-overflow: ellipsis;
	}

	.finder__select:hover {
		color: var(--color-brand);
	}

	.finder__select:focus-visible {
		outline: 2px solid var(--color-mark);
		outline-offset: 4px;
		border-radius: var(--radius);
	}

	.finder__select option {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		color: var(--color-text);
		background: var(--color-bg);
	}

	/* The dropdown's chevron, drawn in the text colour. */
	.finder__field::after {
		content: "";
		position: absolute;
		right: 0.2em;
		top: 50%;
		width: 0.32em;
		height: 0.32em;
		border-right: 0.07em solid currentColor;
		border-bottom: 0.07em solid currentColor;
		transform: translateY(-75%) rotate(45deg);
		pointer-events: none;
	}

	.finder__button {
		margin-top: var(--spacing-6);
		height: 3.25rem;
		padding: 0 var(--spacing-8);
		font: inherit;
		font-size: var(--font-size-base);
		font-weight: 600;
		/* Primary button: Violet Blue ink with white text (9.2:1). */
		color: var(--color-on-button);
		background: var(--color-button);
		border: 0;
		border-radius: var(--radius);
		cursor: pointer;
		transition: background var(--transition-fast);
	}

	/* Hover: the darkened Cerulian, whose white text still passes (5.4:1). */
	.finder__button:hover {
		color: var(--color-on-button-hover);
		background: var(--color-button-hover);
	}

	.finder__button:focus-visible {
		outline: 2px solid var(--color-mark);
		outline-offset: 2px;
	}

	/* Towns as plain links: the way in without the dropdowns. */
	.towns {
		margin-top: var(--spacing-8);
	}

	.towns__label {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text-secondary);
	}

	.towns__list {
		list-style: none;
		margin: var(--spacing-2) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-1) var(--spacing-5);
	}

	.towns__list a {
		display: inline-block;
		padding: var(--spacing-1) 0;
		color: var(--color-brand);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.towns__list a:hover {
		color: var(--color-brand-hover);
	}

	.towns__count {
		margin-left: 0.35em;
		font-size: var(--font-size-sm);
		font-variant-numeric: tabular-nums;
		color: var(--color-muted);
	}

	/* The poster: the town's travel-poster drawing, labelled as one. */
	.hero__poster {
		position: relative;
		margin: 0;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-sand);
	}

	.hero__poster img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: opacity 180ms ease;
	}

	.hero__poster img[data-swapping] {
		opacity: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__poster img {
			transition: none;
		}
	}

	.hero__poster-caption {
		position: absolute;
		right: var(--spacing-2);
		bottom: var(--spacing-2);
		padding: 1px 6px;
		font-size: 9px;
		line-height: 1.4;
		color: var(--color-text);
		background: var(--color-bg);
		border-radius: 2px;
	}

	@media (min-width: 960px) {
		.hero {
			grid-template-columns: minmax(0, 13fr) minmax(0, 11fr);
			align-items: center;
			gap: var(--spacing-12);
			padding: var(--spacing-16) 0 var(--spacing-16);
		}

		/* Taller than 16:9 beside the sentence; the drawings crop well. */
		.hero__poster {
			aspect-ratio: 4 / 5;
		}
	}

	/* ---------- Sections ---------- */

	.home-section {
		padding-top: var(--spacing-12);
		margin-top: var(--spacing-12);
		border-top: 1px solid var(--color-border);
	}

	.hero + .home-section,
	.hero + :global([data-ad-space]) + .home-section {
		margin-top: 0;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--spacing-2) var(--spacing-6);
		margin-bottom: var(--spacing-8);
	}

	.section-title {
		font-family: var(--font-display);
		font-weight: var(--font-weight-display);
		font-size: clamp(var(--font-size-xl), 1.2rem + 1.4vw, var(--font-size-3xl));
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	/* The heading with the "Visiting" switch beside it (under it on phones). */
	.kinds__head {
		margin-bottom: var(--spacing-4);
	}

	/* The region's empty state sits right under the heading; no second rule. */
	.kinds :global(.listing-empty) {
		border-top: 0;
		padding-top: var(--spacing-2);
	}

	.section-more {
		font-weight: 600;
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
	}

	.section-more:hover {
		color: var(--color-brand-hover);
	}

	/* ---------- Browse by kind: one drawing per kind ---------- */

	.kinds__grid {
		list-style: none;
		margin: var(--spacing-4) 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-6) var(--spacing-4);
	}

	@media (min-width: 640px) {
		.kinds__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 1000px) {
		.kinds__grid {
			grid-template-columns: repeat(5, minmax(0, 1fr));
			gap: var(--spacing-8) var(--spacing-6);
		}
	}

	.kind {
		display: flex;
		flex-direction: column;
		color: var(--color-text);
		text-decoration: none;
	}

	.kind__art {
		display: block;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-sand);
