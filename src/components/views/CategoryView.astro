---
import { getEmDashCollection, getTaxonomyTermsWithCacheHint, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import AdSpace from "../AdSpace.astro";
import ListingHeader from "./ListingHeader.astro";
import ListingEmpty from "./ListingEmpty.astro";
import PlaceGrid from "./PlaceGrid.astro";
import RegionSwitch from "../RegionSwitch.astro";
import { inFeedAfter } from "../../utils/ads";
import type { TaxonomyTerm } from "emdash";
import { localePath } from "../../utils/i18n";
import { t, tn } from "../../utils/strings";
import { primaryKind } from "../../utils/kind";
import { REGION_IN, regionFromUrl, regionTermSlug, withRegion } from "../../utils/region";
import { townFromUrl, townLocative, townTermSlug, withTown } from "../../utils/towns";

const locale = Astro.currentLocale;

interface Props {
	term: TaxonomyTerm;
}

const { term } = Astro.props;
// The "Visiting" choice (?region=trnc|south); null is the whole island.
const region = regionFromUrl(Astro.url);
const regionIn = region ? t(locale, REGION_IN[region]) : "";

// The town (?town=<key>), from the home page finder or a town listing. As on
// /posts, it only filters when the `town` taxonomy has the term.
const townChoice = townFromUrl(Astro.url);
const { data: townTerms, cacheHint: townsHint } = await getTaxonomyTermsWithCacheHint("town", {
	locale,
	includeCounts: false,
});
const townSlug = townChoice ? townTermSlug(locale, townChoice.key) : undefined;
const townTerm = townSlug ? townTerms.find((candidate) => candidate.slug === townSlug) : undefined;
const town = townChoice && townTerm ? { key: townChoice.key, slug: townTerm.slug, name: townTerm.label } : null;
// "in Kyrenia" / "Girne'de": a town is narrower than a region, so it wins.
const placeIn = town ? t(locale, "town.in", { town: townLocative(locale, town.name) }) : regionIn;

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	locale,
	// Taxonomy filters AND together: this category, and the region and town when chosen.
	where: {
		category: term.slug,
		...(region ? { region: regionTermSlug(locale, region) } : {}),
		...(town ? { town: town.slug } : {}),
	},
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(townsHint);
}

// Places without a photo show their own kind's drawing (a bar listed under
// Entertainment still gets the glass; a place under the town category "girne"
// gets its real kind). One batched query, only for those places.
const noPhotoKinds = await getTermsForEntries(
	"posts",
	posts.filter((p) => !p.data.featured_image).map((p) => p.data.id),
	"category",
	{ locale },
);

const crumbs = [
	{ label: t(locale, "listing.home"), href: localePath(locale, "/") },
	{
		label: t(locale, "listing.allPlaces"),
		href: withTown(withRegion(localePath(locale, "/posts"), region), town?.key ?? null),
	},
];
---

<Base
	title={
		town
			? t(locale, "listing.categoryTownTitle", { label: term.label, town: townLocative(locale, town.name, "of") })
			: t(locale, "listing.categoryTitle", { label: term.label })
	}
	description={term.description || t(locale, "listing.categoryDescription", { label: term.label })}
>
	{/* ad-manager has no category page type; "tag" is the closest (a taxonomy archive). */}
	<AdSpace space="top-banner" page="tag" />
	<section class="listing">
		<ListingHeader
			title={term.label}
			count={
				posts.length === 0
					? undefined
					: placeIn
						? tn(locale, "region.count", posts.length, { in: placeIn })
						: tn(locale, "listing.place", posts.length)
			}
			crumbs={crumbs}
			crumbLabel={t(locale, "listing.breadcrumb")}
		>
			{town && (
				<p class="listing-town">
					<a href={withTown(Astro.url, null)}>{t(locale, "town.clear")}</a>
				</p>
			)}
			{term.description && <p class="listing-intro">{term.description}</p>}
			<RegionSwitch class="listing-region" />
		</ListingHeader>

		{
			posts.length === 0 ? (
				town ? (
					<ListingEmpty
						message={t(locale, "region.emptyCategory", { label: term.label, in: placeIn })}
						actions={[{ label: t(locale, "town.clear"), href: withTown(Astro.url, null) }]}
					/>
				) : region ? (
					<ListingEmpty
						message={t(locale, "region.emptyCategory", { label: term.label, in: regionIn })}
						actions={[{ label: t(locale, "region.emptyWhole"), href: withRegion(Astro.url, null) }]}
					/>
				) : (
					<ListingEmpty message={t(locale, "listing.categoryEmpty", { label: term.label })} />
				)
			) : (
				<PlaceGrid>
					{posts.map((post, index) => (
						<>
							<PostCard
								title={post.data.title}
								excerpt={post.data.excerpt}
								featuredImage={post.data.featured_image}
								href={localePath(locale, `/${post.id}`)}
								kindSlug={primaryKind(noPhotoKinds.get(post.data.id))?.slug ?? term.slug}
								priority={index < 3}
							/>
							{inFeedAfter(index, posts.length) && <AdSpace space="in-feed" />}
						</>
					))}
				</PlaceGrid>
			)
		}
	</section>
</Base>

<style>
	.listing {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) 0;
	}

	.listing :global(.listing-region) {
		margin-top: var(--spacing-4);
	}

	.listing-town {
		margin: var(--spacing-2) 0 0;
	}

	.listing-town a {
		font-weight: 500;
	}

	.listing-intro {
		max-width: 68ch;
		margin: var(--spacing-4) 0 0;
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	@media (max-width: 760px) {
		.listing {
			padding: var(--spacing-8) var(--spacing-4) 0;
		}
	}
</style>
