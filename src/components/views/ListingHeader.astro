---
/**
 * Shared header for the archive views (all places, category, tag, search):
 * an optional breadcrumb, the display-face h1, and a plain count/lead line.
 */
interface Crumb {
	label: string;
	href: string;
}

interface Props {
	title: string;
	/** Short line above the title, in body text (e.g. "Places tagged"). Not an eyebrow label. */
	lead?: string;
	count?: string;
	crumbs?: Crumb[];
	crumbLabel?: string;
}

const { title, lead, count, crumbs, crumbLabel } = Astro.props;
---

<header class="listing-header">
	{
		crumbs && crumbs.length > 0 && (
			<nav class="crumbs" aria-label={crumbLabel}>
				<ol>
					{crumbs.map((crumb) => (
						<li>
							<a href={crumb.href}>{crumb.label}</a>
						</li>
					))}
					<li aria-current="page">{title}</li>
				</ol>
			</nav>
		)
	}
	{lead && <p class="listing-lead">{lead}</p>}
	<h1 class="listing-title">{title}</h1>
	{count && <p class="listing-count">{count}</p>}
	<slot />
</header>

<style>
	.listing-header {
		margin-bottom: var(--spacing-12);
	}

	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-1) 0;
		list-style: none;
		margin: 0 0 var(--spacing-6);
		padding: 0;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.crumbs li + li::before {
		content: "/";
		margin-inline: var(--spacing-2);
		color: var(--color-border);
	}

	/* Same as the place page: links in the darkened Cerulian, the current
	 * crumb in ink. */
	.crumbs a {
		color: var(--color-brand);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.2em;
	}

	.crumbs a:hover {
		text-decoration-color: currentColor;
	}

	.crumbs a:focus-visible {
		outline: 2px solid var(--color-mark);
		outline-offset: 2px;
		border-radius: var(--radius);
	}

	.crumbs [aria-current] {
		color: var(--color-text);
	}

	.listing-lead {
		font-size: var(--font-size-base);
		font-weight: 600;
		color: var(--color-text-secondary);
		margin: 0 0 var(--spacing-1);
	}

	.listing-title {
		font-family: var(--font-display);
		font-weight: var(--font-weight-display);
		font-size: var(--font-size-5xl);
		line-height: 1.08;
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin: 0;
		max-width: 20ch;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.listing-count {
		margin: var(--spacing-3) 0 0;
		font-size: var(--font-size-lg);
		color: var(--color-muted);
	}

	@media (max-width: 760px) {
		.listing-header {
			margin-bottom: var(--spacing-8);
		}

		.listing-title {
			font-size: var(--font-size-3xl);
		}

		.listing-count {
			font-size: var(--font-size-base);
		}
	}
</style>
