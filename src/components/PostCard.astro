---
/**
 * A place card: photo first, then the place name and what kind of place it is.
 * The whole card is one link. Blog meta (author, date, reading time, tag chips)
 * is not shown; those props are still accepted so older callers keep working.
 */
import type { MediaValue, ContentBylineCredit } from "emdash";
import { Image } from "emdash/ui";
import KindPlaceholder from "./KindPlaceholder.astro";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	/** The place's kind, usually its category label. Shown under the title. */
	kind?: string;
	/** The kind's category slug: picks the illustration on the no-photo tile. */
	kindSlug?: string;
	/** Heading level for the title; defaults to h2 (cards under a page h1). */
	headingLevel?: 2 | 3;
	/** Load the photo eagerly (first row above the fold). */
	priority?: boolean;
	/** @deprecated Not shown on place cards. */
	date?: Date;
	/** @deprecated Not shown on place cards. */
	readingTime?: number;
	/** @deprecated Not shown on place cards. */
	tags?: Array<{ slug: string; label: string }>;
	/** @deprecated Not shown on place cards. */
	bylines?: ContentBylineCredit[];
}

const { title, featuredImage, href, kind, kindSlug, headingLevel = 2, priority = false } = Astro.props;

const Heading = headingLevel === 3 ? "h3" : "h2";
---

<article class="place-card">
	<a href={href} class="place-card__link">
		<div class="place-card__photo" data-photo-frame>
			{featuredImage ? <Image image={featuredImage} priority={priority} /> : <KindPlaceholder kind={kindSlug} priority={priority} />}
		</div>
		<Heading class="place-card__title">{title}</Heading>
		{kind && <p class="place-card__kind">{kind}</p>}
	</a>
</article>

<style>
	.place-card {
		min-width: 0;
	}

	.place-card__link {
		display: block;
		color: inherit;
		text-decoration: none;
		border-radius: var(--radius);
	}

	.place-card__link:focus-visible {
		outline: 2px solid var(--color-mark);
		outline-offset: 4px;
	}

	.place-card__photo {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-sand);
		margin-bottom: var(--spacing-3);
	}

	.place-card__photo :global(img),
	.place-card__photo :global(picture) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.place-card__title {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		font-weight: 600;
		line-height: var(--leading-snug);
		letter-spacing: 0;
		color: var(--color-text);
		margin: 0;
		text-decoration-line: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	/* Hover: an English Red underline under ink text (a mark, not text). */
	.place-card__link:hover .place-card__title {
		text-decoration-color: var(--color-mark);
		text-decoration-thickness: 2px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.place-card__title {
			transition: text-decoration-color var(--transition-fast);
		}
	}

	.place-card__kind {
		margin: var(--spacing-1) 0 0;
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
		color: var(--color-muted);
	}
</style>
