			.site-footer :global(:focus-visible) {
				outline-color: var(--color-on-ink-band);
			}

			.footer-grid {
				display: grid;
				grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
				gap: var(--spacing-12);
				margin-bottom: var(--spacing-12);
