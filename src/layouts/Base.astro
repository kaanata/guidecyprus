			/* LiveSearch prints the raw collection name ("posts", "pages"), which
			   means nothing to a traveller; every result is a place or a page. */
			.site-header :global(.site-search-result .emdash-live-search-result-collection) {
				display: none;
			}

			.site-header :global(.site-search-result .emdash-live-search-result-snippet) {
