				font-size: var(--font-size-sm);
				color: var(--color-on-ink-band-muted);
				line-height: var(--leading-normal);
			}

			.footer-nav {
				min-width: 0;
			}

			/* Sentence case, weight not tracking. */
			.footer-heading,
			.footer-widgets-section :global(.widget__title) {
