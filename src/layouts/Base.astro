				font-size: var(--font-size-sm);
				font-weight: 600;
				letter-spacing: 0;
				text-transform: none;
				color: var(--color-on-ink-band);
				margin-bottom: var(--spacing-3);
			}

			.footer-links {
				list-style: none;
			}

			.footer-links li + li {
				margin-top: var(--spacing-1);
			}

			.footer-links a {
				display: inline-block;
				padding: var(--spacing-1) 0;
				color: var(--color-on-ink-band-muted);
				text-decoration: none;
				font-size: var(--font-size-sm);
			}

			.footer-links a:hover {
				color: var(--color-on-ink-band);
				text-decoration: underline;
				text-underline-offset: 0.2em;
			}

			.footer-widgets-section :global(.widget-area) {
				display: block;
			}

			.footer-widgets-section :global(.widget),
			.footer-widgets-section :global(.widget__content) {
				color: var(--color-on-ink-band-muted);
				font-size: var(--font-size-sm);
				line-height: var(--leading-normal);
			}

			.footer-widgets-section :global(.widget + .widget) {
				margin-top: var(--spacing-8);
			}

			.footer-widgets-section :global(a) {
				color: var(--color-on-ink-band);
				text-decoration: underline;
				text-underline-offset: 0.2em;
			}

			.footer-bottom {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: var(--spacing-4);
				padding-top: var(--spacing-6);
				border-top: 1px solid color-mix(in srgb, var(--color-on-ink-band) 18%, transparent);
			}

			.footer-copyright {
				font-size: var(--font-size-xs);
				color: var(--color-on-ink-band-muted);
			}

			.footer-copyright a {
				color: var(--color-on-ink-band);
				text-decoration: underline;
				text-underline-offset: 0.2em;
			}

			.footer-copyright a:hover {
				color: var(--color-on-ink-band);
				text-decoration-thickness: 2px;
			}

			/* Theme switcher, restyled for the dark band. */
			.theme-switcher {
				display: flex;
				gap: 2px;
				padding: 2px;
				border: 1px solid color-mix(in srgb, var(--color-on-ink-band) 22%, transparent);
				border-radius: var(--radius-lg);
			}

			.theme-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 36px;
				height: 32px;
				background: transparent;
				border: none;
				color: var(--color-on-ink-band-muted);
				border-radius: var(--radius);
				cursor: pointer;
				transition:
					color var(--transition-fast),
					background-color var(--transition-fast);
			}

			.theme-btn:hover {
				color: var(--color-on-ink-band);
			}

			/* Active choice: a flat light tile with band-coloured ink. */
			.theme-btn.active,
			.theme-btn.active:hover {
				background: var(--color-on-ink-band);
				color: var(--color-ink-band);
			}

			.theme-btn svg {
				width: 16px;
				height: 16px;
			}

			@media (max-width: 1080px) {
				.header-inner {
					gap: var(--spacing-6);
				}

				.site-header :global(.site-search) {
					width: 12rem;
				}
			}

			@media (max-width: 900px) {
				.footer-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: var(--spacing-10) var(--spacing-8);
				}

				.footer-brand {
					grid-column: 1 / -1;
					max-width: none;
				}
			}

			/* Phones: wordmark (and admin) on top, search full width, then the
			   menu as one line that scrolls sideways if it has to. */
			@media (max-width: 760px) {
				.site-header {
					position: relative;
				}

				.header-inner {
					display: grid;
					grid-template-columns: minmax(0, 1fr) auto;
					grid-template-areas:
						"brand admin"
						"search search"
						"links links";
					height: auto;
					gap: var(--spacing-3) var(--spacing-4);
					padding: var(--spacing-4) var(--spacing-4) 0;
				}

				.header-inner > :global(.header-brand) {
					grid-area: brand;
				}

				.nav-admin {
					grid-area: admin;
				}

				.site-header :global(.site-search) {
					grid-area: search;
					width: 100%;
				}

				.site-header :global(.site-search input.site-search-input) {
