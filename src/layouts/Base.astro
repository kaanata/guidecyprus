			/* Footer: the Violet Blue band (--color-ink-band), light ink on it.
			   Focus rings switch to that light ink: red on Violet Blue is 2.6:1. */
			.site-footer {
				margin-top: var(--spacing-16);
				background: var(--color-ink-band);
				color: var(--color-on-ink-band);
			}

