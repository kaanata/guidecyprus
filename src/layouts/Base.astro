					font-size: var(--font-size-base);
				}

				.site-header :global(.site-search .site-search-results) {
					left: 0;
					right: 0;
					width: auto;
				}

				.nav-links {
					grid-area: links;
					margin: 0 calc(-1 * var(--spacing-4));
					overflow-x: auto;
					scrollbar-width: none;
					-webkit-overflow-scrolling: touch;
				}

				.nav-links::-webkit-scrollbar {
					display: none;
				}

				.nav-links ul {
					gap: var(--spacing-5);
					padding: 0 var(--spacing-4);
					width: max-content;
				}

				.nav-links a {
					padding: var(--spacing-3) 0;
					text-underline-offset: 0.6em;
				}

				.site-footer {
					margin-top: var(--spacing-12);
				}

				.footer-inner {
					padding: var(--spacing-12) var(--spacing-4) var(--spacing-6);
				}
			}

			@media (max-width: 480px) {
				.footer-grid {
					grid-template-columns: minmax(0, 1fr);
					gap: var(--spacing-8);
				}

				.footer-bottom {
					flex-direction: column-reverse;
					align-items: flex-start;
				}
			}
		</style>

		<script>
			// Many places use a logo as their photo. Cropping a logo to fill a
			// card cuts it apart, so when an image's border is one flat colour
			// (a logo on a plain ground), show it whole on a tile of that colour.
			// Photos keep their crop. Illustrations (img[data-illustration], flat
			// drawings that would read as logos) always fill their box.
			const SAMPLE = 40;
			const TOLERANCE = 28;
			const FLAT_SHARE = 0.85;

			function edgeColour(img: HTMLImageElement): string | null {
				const canvas = document.createElement("canvas");
				canvas.width = canvas.height = SAMPLE;
				const ctx = canvas.getContext("2d", { willReadFrequently: true });
				if (!ctx) return null;
				let data: Uint8ClampedArray;
				try {
					ctx.drawImage(img, 0, 0, SAMPLE, SAMPLE);
					data = ctx.getImageData(0, 0, SAMPLE, SAMPLE).data;
				} catch {
					return null; // cross-origin or undecodable
				}
				const edge: number[][] = [];
				for (let i = 0; i < SAMPLE; i++) {
					for (const [x, y] of [[i, 0], [i, SAMPLE - 1], [0, i], [SAMPLE - 1, i]]) {
						const o = (y * SAMPLE + x) * 4;
						// Transparent pixels sit on white, as the logo was designed.
						const a = data[o + 3] / 255;
						edge.push([0, 1, 2].map((c) => data[o + c] * a + 255 * (1 - a)));
					}
				}
				const median = [0, 1, 2].map((c) => {
					const v = edge.map((p) => p[c]).sort((a, b) => a - b);
					return v[v.length >> 1];
				});
				const near = (p: number[], q: number[]) =>
					Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]) < TOLERANCE;
				if (edge.filter((p) => near(p, median)).length / edge.length >= FLAT_SHARE) {
					return `rgb(${median.map(Math.round).join(" ")})`;
				}
				// Artwork that runs into the edges can still sit on plain corners.
				const last = SAMPLE - 1;
				const corners = [[0, 0], [last, 0], [0, last], [last, last]].map(([x, y]) => {
					const o = (y * SAMPLE + x) * 4;
					const a = data[o + 3] / 255;
					return [0, 1, 2].map((c) => data[o + c] * a + 255 * (1 - a));
				});
				if (!corners.every((p) => near(p, corners[0]))) return null;
				const mean = [0, 1, 2].map((c) => corners.reduce((s, p) => s + p[c], 0) / 4);
				return `rgb(${mean.map(Math.round).join(" ")})`;
			}

			function fitPhoto(img: HTMLImageElement) {
				const frame = img.closest<HTMLElement>("[data-photo-frame]");
				if (!frame || frame.dataset.logo !== undefined) return;
				const colour = edgeColour(img);
				if (!colour) return;
				frame.dataset.logo = "";
				frame.style.backgroundColor = colour;
			}

			for (const img of document.querySelectorAll<HTMLImageElement>(
				"[data-photo-frame] img:not([data-illustration])",
			)) {
				if (img.complete && img.naturalWidth) fitPhoto(img);
				else img.addEventListener("load", () => fitPhoto(img), { once: true });
			}
		</script>

		<script>
			// ⌘K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const searchInput = document.querySelector(
						".site-search-input"
					) as HTMLInputElement;
					if (searchInput) {
						searchInput.focus();
					}
				}
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
